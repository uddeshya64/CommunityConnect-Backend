# ==========================================
# CommunityConnect Backend Environment Variables
# ==========================================

# Server Port
PORT=3000

# Database URLs
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# JWT Secrets
JWT_SECRET="your-jwt-secret-here-min-10-chars"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here-min-10-chars"
RESET_TOKEN_SECRET="your-reset-token-secret-here-min-10-chars"
ACCESS_TOKEN_EXPIRES_IN="1d"
REFRESH_TOKEN_EXPIRES_IN="15d"
REFRESH_TOKEN_EXPIRES_DAYS=15

# ==========================================
# URL CONFIGURATION (LOCAL vs PRODUCTION)
# ==========================================
# For Local Development:
FRONTEND_URL="http://localhost:3001"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
# Optional additional CORS origins (comma-separated):
# ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# For Live Production (Render / Railway / VPS / Cloud):
# FRONTEND_URL="https://your-frontend-domain.com"
# GOOGLE_CALLBACK_URL="https://your-backend-api-domain.com/api/auth/google/callback"
# ALLOWED_ORIGINS="https://your-frontend-domain.com"

# Payment (Razorpay)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."

# Email (Brevo SMTP & Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
BREVO_SMTP_USER="smtp-user@smtp-brevo.com"
BREVO_SMTP_KEY="xsmtpsib-..."
BREVO_SENDER_EMAIL="your-sender-email@example.com"
BREVO_SENDER_NAME="CommunityConnect"
BREVO_API_URL="https://api.brevo.com/v3/smtp/email"

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:support@communityconnect.dev"

# Maps (Mapbox)
MAPBOX_ACCESS_TOKEN="..."

# Supabase (Storage & Auth)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="sb_secret_..."

# Google OAuth
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# AI Event Creation (Optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
